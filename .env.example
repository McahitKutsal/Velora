# Google OAuth client ID - https://console.cloud.google.com/apis/credentials
# Both vars must hold the same Client ID (web client).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# JWT signing secret. Generate a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=replace-with-a-long-random-string

# --- Database ---
# Local dev (default): a file under ./data/velora.db is used if neither var is set.
#   You can override the file path:
# DATABASE_PATH=./data/velora.db
#
# Production (Vercel): use Turso. Create a DB at https://turso.tech and fill these:
# TURSO_DATABASE_URL=libsql://your-db-name-org.turso.io
# TURSO_AUTH_TOKEN=ey...
